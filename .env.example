# Copy to .env (git-ignored) and adjust if needed. Local development values only.

# Used by docker compose to create the database.
POSTGRES_USER=anemos
POSTGRES_PASSWORD=anemos_dev
POSTGRES_DB=anemos
# Host port; 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

# Used by the Python code (loaded with `uv run --env-file .env ...`).
# Write it out in full: no ${VAR} expansion is relied on.
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 (::1) first and hangs,
# because compose publishes the port on IPv4 only.
DATABASE_URL=postgresql://anemos:anemos_dev@127.0.0.1:5433/anemos

# Model spend cap in US dollars for every call made from this machine (D2). Calls that
# could pass it are refused. Spend is recorded in var/llm_spend.jsonl (git-ignored).
# Also set a hard usage limit in the OpenAI dashboard: this cap guards this machine,
# the dashboard guards the account.
ANEMOS_LLM_BUDGET_USD=2.00

# OpenAI API key for model calls (from week 4). Read only when a real call is made;
# tests and CI never need it. Keep it here in .env (git-ignored), never in the code.
OPENAI_API_KEY=

# The owner's shared password for the UI and the API (D82): at least 12 characters, or
# `python -m anemos.api` refuses to start. Choose your own; never commit it.
ANEMOS_OWNER_PASSWORD=
# The session cookie is Secure by default. Set to false only if your local browser
# refuses a Secure cookie on http://127.0.0.1 (see docs/NOTES.md).
# ANEMOS_COOKIE_SECURE=false
