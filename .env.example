# Copy to .env (git-ignored) and adjust if needed. Local development values only.

# Used by docker compose to create the database.
POSTGRES_USER=anemos
POSTGRES_PASSWORD=anemos_dev
POSTGRES_DB=anemos
# Host port; 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

# Used by the Python code (loaded with `uv run --env-file .env ...`).
# Write it out in full: no ${VAR} expansion is relied on.
DATABASE_URL=postgresql://anemos:anemos_dev@localhost:5433/anemos
